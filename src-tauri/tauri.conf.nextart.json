{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXTART Agent Pro",
  "version": "1.1.2",
  "identifier": "com.nextart.agent-pro",
  "build": {
    "frontendDist": "https://agent.sunnytoon.com/?c=nextart"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEXTART Agent Pro — AI WORKTEAM",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://agent.sunnytoon.com; script-src 'self' 'unsafe-inline' https://agent.sunnytoon.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://agent.sunnytoon.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://agent.sunnytoon.com https://pddasonkizwviwqzdhpu.supabase.co wss://pddasonkizwviwqzdhpu.supabase.co https://api.anthropic.com https://api.telegram.org https://story.sunnytoon.com; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sunny Soft",
    "homepage": "https://agent.sunnytoon.com",
    "category": "Productivity",
    "shortDescription": "NEXTART AI WORKTEAM — 8 페르소나 데스크탑 앱",
    "longDescription": "NEXTART (넥스트아트) AI WORKTEAM 8 페르소나 데스크탑 앱. 본인 Claude Code CLI를 통해 본인 Pro/Max 구독으로 작업.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agent-pro-nextart"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://story.sunnytoon.com/api/agent-updater/nextart/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4NDhBRkE2NjYxOEEwMTUKUldRVm9CaG1wcTlJR0JVdDBIZVdaL2s0Z3RjMG5KejFCWmNIcXZ4L3Z2NUhqem95T1RaMTRvMmIK"
    }
  }
}
